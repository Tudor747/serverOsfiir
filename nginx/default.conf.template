# Unknown hostnames do not get a TLS connection.
server {
    listen 443 ssl default_server;
    server_name _;
    ssl_reject_handshake on;
}

server {
    listen 443 ssl;
    server_name ${SERVER_DOMAIN} ${SECOND_DOMAIN};
    ssl_certificate /etc/letsencrypt/live/server/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/server/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    default_type text/plain;

    # Infrastructure checks only. No website or application is deployed.
    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }
    location / {
        return 200 "Server is ready.\n";
    }
}
